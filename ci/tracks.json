{
  "version": 1,
  "description": "Parallel CI execution model from devplan/testing/AutomationTestPlan_Parallel.md section 3. Each job maps to a track of concrete test commands. Fill in commands here when new tracks land.",
  "jobs": {
    "static-analysis": {
      "name": "Job 1 - Static Analysis",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #3 (Job 1)",
      "commands": [
        { "label": "oxlint", "cwd": ".", "run": "bun run lint", "timeoutMinutes": 10 },
        { "label": "typecheck all packages", "cwd": ".", "run": "bun typecheck", "timeoutMinutes": 20 }
      ]
    },
    "contract": {
      "name": "Job 2 - Contract Tests",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #5 (Contract Test Track)",
      "commands": [
        {
          "label": "schema contract tests (serialization, migration, compatibility)",
          "cwd": "packages/schema",
          "run": "bun run test",
          "timeoutMinutes": 10
        },
        {
          "label": "protocol contract tests (cursors, boundaries)",
          "cwd": "packages/protocol",
          "run": "bun run test",
          "timeoutMinutes": 10
        },
        {
          "label": "sdk-next contract tests (embedded, import boundaries)",
          "cwd": "packages/sdk-next",
          "run": "bun run test",
          "timeoutMinutes": 10
        },
        {
          "label": "generated SDK correctness check",
          "cwd": "packages/client",
          "run": "bun run check:generated",
          "timeoutMinutes": 10
        },
        {
          "label": "http api exerciser gates (endpoint compatibility, auth)",
          "cwd": "packages/opencode",
          "run": "bun run test:httpapi",
          "timeoutMinutes": 30
        }
      ]
    },
    "backend-unit": {
      "name": "Job 3 - Backend Unit Tests",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #3 (Job 3)",
      "commands": [
        { "label": "core unit tests", "cwd": "packages/core", "run": "bun run test", "timeoutMinutes": 20 },
        { "label": "llm unit tests", "cwd": "packages/llm", "run": "bun run test", "timeoutMinutes": 20 },
        {
          "label": "effect-drizzle-sqlite unit tests",
          "cwd": "packages/effect-drizzle-sqlite",
          "run": "bun run test",
          "timeoutMinutes": 20
        },
        {
          "label": "http-recorder unit tests",
          "cwd": "packages/http-recorder",
          "run": "bun run test",
          "timeoutMinutes": 20
        },
        {
          "label": "httpapi-codegen unit tests",
          "cwd": "packages/httpapi-codegen",
          "run": "bun run test",
          "timeoutMinutes": 20
        },
        { "label": "codemode unit tests", "cwd": "packages/codemode", "run": "bun run test", "timeoutMinutes": 20 },
        { "label": "enterprise unit tests", "cwd": "packages/enterprise", "run": "bun run test", "timeoutMinutes": 20 }
      ]
    },
    "frontend-unit": {
      "name": "Job 4 - Frontend Unit Tests",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #3 (Job 4)",
      "commands": [
        { "label": "ui unit tests", "cwd": "packages/ui", "run": "bun run test", "timeoutMinutes": 20 },
        { "label": "session-ui unit tests", "cwd": "packages/session-ui", "run": "bun run test", "timeoutMinutes": 20 },
        { "label": "client unit tests", "cwd": "packages/client", "run": "bun run test", "timeoutMinutes": 20 },
        { "label": "tui unit tests", "cwd": "packages/tui", "run": "bun run test", "timeoutMinutes": 20 },
        { "label": "app unit tests (solid)", "cwd": "packages/app", "run": "bun run test:unit", "timeoutMinutes": 20 }
      ]
    },
    "platform-integration": {
      "name": "Job 5 - Platform Integration",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #6-9, #12 (Workspace/Layout, Functionality Runtime, Permission, Operation/Event, Storage)",
      "commands": [
        {
          "label": "opencode platform suite (workspace, runtime, permission, operation, event, storage, server)",
          "cwd": "packages/opencode",
          "run": "bun run test",
          "timeoutMinutes": 30
        }
      ]
    },
    "feature-integration": {
      "name": "Job 6 - Feature Integration",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #10-11 (Canvas, Chat, MCP Search, Screenshot, App Stream Placeholder)",
      "commands": [
        {
          "label": "chat track (steer, queue, cancellation, context)",
          "cwd": "packages/opencode",
          "run": "bun test --timeout 30000 test/session test/agent",
          "timeoutMinutes": 20
        },
        {
          "label": "mcp search track (provider selection, malformed output, credential isolation)",
          "cwd": "packages/opencode",
          "run": "bun test --timeout 30000 test/mcp",
          "timeoutMinutes": 20
        },
        {
          "label": "screenshot track (thumbnails, artifact access, attachment)",
          "cwd": "packages/opencode",
          "run": "bun test --timeout 30000 test/image",
          "timeoutMinutes": 20
        },
        {
          "label": "canvas track (browser env rendering)",
          "cwd": "packages/app",
          "run": "bun run test:browser",
          "timeoutMinutes": 20
        }
      ]
    },
    "browser-e2e": {
      "name": "Job 7 - Browser E2E",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #3 (Job 7)",
      "commands": [
        {
          "label": "playwright e2e",
          "cwd": "packages/app",
          "run": "bun run test:e2e:local",
          "timeoutMinutes": 30,
          "env": { "CI": "true" }
        }
      ]
    },
    "security": {
      "name": "Job 8 - Security",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #8, #13 (Permission Enforcement, Security Parallel Track)",
      "commands": [
        {
          "label": "gitleaks secret scan",
          "cwd": ".",
          "run": "gitleaks detect --source . --redact --no-banner --exit-code 1",
          "timeoutMinutes": 10
        },
        { "label": "dependency audit", "cwd": ".", "run": "bun audit", "timeoutMinutes": 10 },
        {
          "label": "permission enforcement tests (grants, revoke, forge, cross-workspace)",
          "cwd": "packages/opencode",
          "run": "bun test --timeout 30000 test/permission test/auth test/permission.test.ts test/permission-task.test.ts",
          "timeoutMinutes": 15
        }
      ]
    },
    "performance": {
      "name": "Job 9 - Performance",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #10, #14 (Performance Parallel Track)",
      "commands": [
        {
          "label": "backend test suite benchmark",
          "cwd": "packages/opencode",
          "run": "bun run bench:test",
          "timeoutMinutes": 30
        },
        {
          "label": "frontend performance suite",
          "cwd": "packages/app",
          "run": "bun run test:bench",
          "timeoutMinutes": 30
        }
      ]
    },
    "failure-injection": {
      "name": "Failure Injection (chaos) - NOT IMPLEMENTED",
      "plan": "devplan/testing/AutomationTestPlan_Parallel.md #15",
      "disabled": true,
      "status": "gap: no chaos suite exists yet. Planned home: packages/opencode/test/failure-injection (db restart, network loss, stale client, corrupted artifact, interrupted import, failed MCP server, cancelled operation).",
      "commands": [
        {
          "label": "chaos suite",
          "cwd": "packages/opencode",
          "run": "bun test --timeout 30000 test/failure-injection",
          "timeoutMinutes": 20
        }
      ]
    }
  }
}
