+ 209| function withSessionRecovery<T>(
+ 210|   sessionID: string,
+ 211|   bind: ChatRelaySessionShape,
+ 212|   failure: unknown,
+ 213|   continueWith: (nextSessionID: string) => Effect.Effect<T, unknown, never>,
