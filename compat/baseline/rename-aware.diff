+
+/* Block bar: a two-button pill — palette selector on top, add snapped to the
+   bottom. The palette extends upward as a scrollable vertical pill. */
+.canvas-block-bar-wrap {
+  position: absolute;
+  z-index: 9999;
+  top: 50%;
+  left: 18px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  transform: translateY(-50%);
+}
+
+.canvas-block-bar {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 7px;
+  border: 1px solid var(--canvas-line);
+  border-radius: 20px;
+  background: var(--canvas-surface);
+}
+
+.canvas-block-bar-button {
+  --button-accent: var(--canvas-blue);
+  position: relative;
+  width: 44px;
+  height: 44px;
+  display: grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: 14px;
+  color: color-mix(in srgb, var(--button-accent) 85%, var(--canvas-text));
+  background: transparent;
+  cursor: pointer;
+}
+
+.canvas-block-bar-button svg {
+  width: 18px;
+  height: 18px;
+  stroke: currentColor;
+  fill: none;
+  stroke-width: 1.9;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.canvas-block-bar-button:hover,
+.canvas-block-bar-button.active {
+  background: color-mix(in srgb, var(--button-accent) 14%, transparent);
+  transform: translateY(-1px);
+}
+
+.canvas-block-bar-button::after {
+  content: attr(data-tip);
+  position: absolute;
+  left: calc(100% + 12px);
+  top: 50%;
+  padding: 7px 9px;
+  border: 1px solid var(--canvas-line);
+  border-radius: 10px;
+  color: var(--canvas-text);
+  background: var(--canvas-surface-solid);
+  font-size: 11px;
+  font-weight: 700;
+  opacity: 0;
+  pointer-events: none;
+  transform: translate(-4px, -50%);
+  white-space: nowrap;
+}
+
+.canvas-block-bar-button:hover::after {
+  opacity: 1;
+  transform: translate(0, -50%);
+}
+
+/* Touch has no hover: surface the tip while the button is pressed or focused. */
+.canvas-block-bar-button:active::after,
+.canvas-block-bar-button:focus-visible::after {
+  opacity: 1;
+  transform: translate(0, -50%);
+}
+
+.canvas-block-bar-chevron {
+  position: absolute;
+  right: -2px;
+  bottom: -2px;
+  width: 15px;
+  height: 15px;
+  display: grid;
+  place-items: center;
+  border-radius: 7px;
+  color: var(--canvas-muted);
+  background: var(--canvas-surface-solid);
+}
