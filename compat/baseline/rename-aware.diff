+  [0x1163d, 0x1163d],
+  [0x1163f, 0x11640],
+  [0x116ab, 0x116ab],
+  [0x116ad, 0x116ad],
+  [0x116b0, 0x116b5],
+  [0x116b7, 0x116b7],
+  [0x1171d, 0x1171f],
+  [0x11722, 0x11725],
+  [0x11727, 0x1172b],
+  [0x11c30, 0x11c36],
+  [0x11c38, 0x11c3d],
+  [0x11c3f, 0x11c3f],
+  [0x11c92, 0x11ca7],
+  [0x11caa, 0x11cb0],
+  [0x11cb2, 0x11cb3],
+  [0x11cb5, 0x11cb6],
+  [0x11d31, 0x11d36],
+  [0x11d3a, 0x11d3a],
+  [0x11d3c, 0x11d3d],
+  [0x11d3f, 0x11d45],
+  [0x11d47, 0x11d47],
+  [0x16af0, 0x16af4],
+  [0x16b30, 0x16b36],
+  [0x16f8f, 0x16f92],
+  [0x1bc9d, 0x1bc9e],
+  [0x1d167, 0x1d169],
+  [0x1d173, 0x1d182],
+  [0x1d185, 0x1d18b],
+  [0x1d1aa, 0x1d1ad],
+  [0x1d242, 0x1d244],
+  [0x1da00, 0x1da36],
+  [0x1da3b, 0x1da6c],
+  [0x1da75, 0x1da75],
+  [0x1da84, 0x1da84],
+  [0x1da9b, 0x1da9f],
+  [0x1daa1, 0x1daaf],
+  [0x1e8d0, 0x1e8d6],
+  [0x1e944, 0x1e94a],
+  [0xe0001, 0xe0001],
+  [0xe0020, 0xe007f],
+  [0xe0100, 0xe01ef],
+]
+
+const WIDE: Array<[number, number]> = [
+  [0x1100, 0x115f],
+  [0x2329, 0x232a],
+  [0x2e80, 0x303e],
+  [0x3041, 0x33ff],
+  [0x3400, 0x4dbf],
+  [0x4e00, 0xa4cf],
+  [0xa960, 0xa97f],
+  [0xac00, 0xd7a3],
+  [0xf900, 0xfaff],
+  [0xfe10, 0xfe19],
+  [0xfe30, 0xfe6f],
+  [0xff00, 0xff60],
+  [0xffe0, 0xffe6],
+  [0x1f300, 0x1f64f],
+  [0x1f900, 0x1f9ff],
+  [0x20000, 0x2fffd],
+  [0x30000, 0x3fffd],
+]
+
+function inRanges(code: number, ranges: Array<[number, number]>) {
+  let low = 0
+  let high = ranges.length - 1
+  while (low <= high) {
+    const mid = (low + high) >> 1
+    const [start, end] = ranges[mid]
+    if (code < start) high = mid - 1
+    else if (code > end) low = mid + 1
+    else return true
+  }
+  return false
+}
+
+export function stringWidth(value: string): number {
+  if (!value) return 0
+  let width = 0
+  for (const char of value) {
+    const code = char.codePointAt(0) ?? 0
+    if (code === 0) continue
+    if (code < 0x20 || (code >= 0x7f && code < 0xa0)) continue
+    if (inRanges(code, ZERO_WIDTH)) continue
+    width += inRanges(code, WIDE) ? 2 : 1
+  }
+  return width
+}
