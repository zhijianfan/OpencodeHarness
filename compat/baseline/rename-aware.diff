+    page,
+  }, testInfo) => {
+    const {
+      directory,
+      workspaceID,
+      roles,
+      model,
+      tokens,
+      pack,
+      prompts,
+      materializations,
+      legacyPrompts,
+      errors,
+      requests,
+      browserPrompts,
+      browserResets,
+      browserOpens,
+      browserActions,
+      relayReads,
+      relayTab,
