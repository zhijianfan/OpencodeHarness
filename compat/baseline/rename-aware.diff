+import { Database } from "../database/database"
+import { makeGlobalNode } from "../effect/app-node"
+
+// Tables ----------------------------------------------------------------------
+
+export const CtxPackTable = sqliteTable(
+  "ctx_pack",
+  {
+    id: text().$type<CtxPack.ID>().primaryKey(),
+    workspace_id: text().notNull(),
