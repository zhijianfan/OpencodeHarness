+    expect(decode(MasterAgent.DirectoryBinding)({ mode: "workspace-primary" })).toEqual({ mode: "workspace-primary" })
+    expect(decode(MasterAgent.DirectoryBinding)({ mode: "fixed", directory: "/tmp" })).toEqual({
