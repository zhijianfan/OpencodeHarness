+            mode: "owned",
+            sessionID: input.sessionID,
+            generation: input.generation ?? 0,
+          },
+        }),
+        deleted_at: input.deletedAt ?? null,
+        time_updated: Date.now(),
+      })
+      .run()
+      .pipe(Effect.orDie)
+    return instanceID
+  })
+}
+
+function expectStale(effect: Effect.Effect<void, SessionContextProfile.Error>) {
