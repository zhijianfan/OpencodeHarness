+  return {
+    port,
+    calls,
+    bindings,
+    setCoderModel: (model: ModelSelection | null) => {
+      coderModel = model
+    },
+    failNextPatch() {
+      failNextPatch = true
+    },
+    deferNextPatch() {
+      pendingPatch = Promise.withResolvers<WorkspaceInfo>()
+      return pendingPatch
+    },
