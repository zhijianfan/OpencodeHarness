+export const MASTER_AGENT_MODULE: MasterAgentBlockModule = {
+  type: MASTER_AGENT_BLOCK_TYPE,
+  functionality: MASTER_AGENT_FUNCTIONALITY_ID,
+  title: "Master Agent",
+  subtitle: "Hosted session · coder mode",
+  accent: "var(--canvas-purple)",
+  w: 440,
+  h: 500,
