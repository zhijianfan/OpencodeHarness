+  | {
+      type: "FunctionalityInstance"
+      workspaceID: string
+      instanceID: string
+      functionalityID: string
+    }
+  | {
+      type: "CtxPack"
+      workspaceID: string
+      ctxPackID: string
+      sensitivity: "public" | "workspace" | "private"
+      createdByUserID: string
+    }
