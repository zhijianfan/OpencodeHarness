+  const presentEvents =
+    rows.length === 0
+      ? []
+      : yield* db
+          .select({ seq: EventTable.seq, data: eventData })
+          .from(EventTable)
+          .where(
+            and(
+              eq(EventTable.aggregate_id, sessionID),
+              eq(EventTable.type, EventV2.versionedType(SessionEvent.PromptAdmitted.type, 1)),
+              inArray(
