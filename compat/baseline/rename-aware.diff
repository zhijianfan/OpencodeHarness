+## Suggested props
+
+Conceptually:
+
+```ts
+interface MasterAgentBlockProps {
+  blockID: string
+  binding: MasterAgentBinding | null
+  status: "loading" | "ready" | "error" | "permission-denied"
+  error?: unknown
+  focused: boolean
+  queueEnabled: boolean
+  canReset: boolean
+  onRetry(): void
+  onReset(): void
+  onFocus(): void
+  coderSelector?: JSX.Element
+}
+```
