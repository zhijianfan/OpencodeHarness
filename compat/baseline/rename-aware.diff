+class FakeLocator {
+  constructor(page, selector, index = 0, indexed = false) {
+    this.page = page
+    this.selector = selector
+    this.index = index
+    this.indexed = indexed
+  }
+
+  first() {
+    return this
+  }
+
+  last() {
+    return this
+  }
+
+  nth(index) {
+    return new FakeLocator(this.page, this.selector, index, true)
