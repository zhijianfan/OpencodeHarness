+/* CtxPackBrowser — compact canvas-native block layout. */
+
+.ctxpack-browser {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  padding: 12px;
+  box-sizing: border-box;
+  overflow: hidden;
+  scrollbar-width: thin;
+  scrollbar-color: var(--canvas-line-strong) transparent;
+  font-size: 12px;
+  color: var(--canvas-text);
+  background: transparent;
+}
+
+.ctxpack-browser-main {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 10px;
+  min-width: 0;
+  min-height: 0;
+  overflow: auto;
+  padding-bottom: 2px;
+}
+
+.ctxpack-browser-tabs {
+  display: flex;
+  flex: 0 0 auto;
+  gap: 4px;
+  padding: 2px;
