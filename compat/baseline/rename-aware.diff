+      yield* tx.run(sql`
+        CREATE TABLE ctx_pack_keyword (
+          ctx_pack_id TEXT NOT NULL REFERENCES ctx_pack(id),
+          ordinal INTEGER NOT NULL,
+          keyword_display TEXT NOT NULL,
