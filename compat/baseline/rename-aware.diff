+      !Number.isSafeInteger(chunk.chunkCount) ||
+      !Number.isSafeInteger(chunk.chunkIndex) ||
+      !Number.isSafeInteger(chunk.byteLength) ||
+      chunk.chunkCount <= 0 ||
+      chunk.chunkIndex < 0 ||
+      chunk.chunkIndex >= chunk.chunkCount ||
+      chunk.byteLength < 0
