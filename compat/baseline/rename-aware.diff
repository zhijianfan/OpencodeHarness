+    workspaceID,
+    server,
+    roles,
+    model,
+    tokens,
+    pack,
+    prompts,
+    materializations,
+    legacyPrompts,
+    errors,
+    requests,
+    browserPrompts,
+    browserResets,
+    browserOpens,
+    browserOptionReads,
+    browserConfigurations,
+    browserActions,
+    relayReads: () => relayReads,
+    relayTab: () => relay.tabID,
+    transport,
+  }
+}
