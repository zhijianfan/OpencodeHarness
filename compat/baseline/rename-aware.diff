+ 216|   return Effect.gen(function* () {
+ 217|     const binding = yield* bind.ensure(failure.workspaceID as never, failure.blockID)
+ 218|     if (binding.sessionID === sessionID) {
+ 219|       return yield* continueWith(sessionID)
+ 220|     }
