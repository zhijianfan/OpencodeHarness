+  font-size: 16px;
+  transform: translateY(-1px);
+}
+
+.canvas-workspace-menu[open] .canvas-workspace-chevron {
+  transform: rotate(180deg) translateY(1px);
+}
+
+.canvas-workspace-popover {
+  position: absolute;
+  z-index: 20;
+  top: calc(100% + 13px);
+  left: 0;
+  width: min(320px, calc(100vw - 28px));
+  padding: 10px;
+  border: 1px solid var(--canvas-line);
+  border-radius: 18px;
+  background: var(--canvas-surface-solid);
+}
+
+.canvas-workspace-popover-title {
+  display: flex;
+  justify-content: space-between;
+  padding: 3px 5px 9px;
+  color: var(--canvas-muted);
+  font-size: 10px;
