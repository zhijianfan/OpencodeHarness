+      .notNull()
+      .references(() => CtxPackTable.id),
+    ordinal: integer().notNull(),
+    text_content: text().notNull(),
+    content_hash: text().notNull(),
+    byte_length: integer().notNull(),
+    estimated_tokens: integer().notNull(),
