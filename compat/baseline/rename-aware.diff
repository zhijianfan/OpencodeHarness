+
+  await page.addInitScript(
+    ({ directory, workspaceID }) => {
+      localStorage.setItem("settings.v3", JSON.stringify({ general: { newLayoutDesigns: true } }))
+      localStorage.setItem("opencode.global.dat:language", JSON.stringify({ locale: "en" }))
