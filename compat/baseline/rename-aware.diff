@@ -0,0 +1,2685 @@
+/*
+  Agent Canvas
+  Canvas-workspace art style for the opencode app: infinite dotted canvas,
+  flat cards, pastel accents, floating controls. Light/dark re-resolve through
+  CSS variables keyed on the app's color-scheme attribute.
+*/
+
+:root {
+  --canvas-bg: #f7f6f2;
+  --canvas-surface: #ffffff;
+  --canvas-surface-solid: #ffffff;
+  --canvas-surface-soft: #fbfaf7;
+  --canvas-surface-hover: #f3f1eb;
+  --canvas-text: #252522;
+  --canvas-muted: #73736e;
+  --canvas-faint: #a7a59e;
+  --canvas-line: rgba(39, 39, 34, 0.1);
+  --canvas-line-strong: rgba(39, 39, 34, 0.17);
+  --canvas-grid-dot: rgba(66, 64, 57, 0.15);
+  --canvas-blue: #6f99f5;
+  --canvas-purple: #9b82ed;
+  --canvas-green: #47b881;
+  --canvas-yellow: #f4b740;
+  --canvas-pink: #ee7ba7;
+  --canvas-peach: #ef987a;
+  --canvas-mint: #73c9b3;
+}
+
+html[data-color-scheme="dark"] {
+  --canvas-bg: #171817;
+  --canvas-surface: #242522;
+  --canvas-surface-solid: #242522;
+  --canvas-surface-soft: #20211f;
+  --canvas-surface-hover: #2c2d2a;
+  --canvas-text: #f2f1ec;
+  --canvas-muted: #aaa9a2;
+  --canvas-faint: #777872;
+  --canvas-line: rgba(255, 255, 255, 0.09);
+  --canvas-line-strong: rgba(255, 255, 255, 0.15);
+  --canvas-grid-dot: rgba(255, 255, 255, 0.12);
+}
+
+.canvas-app {
+  position: relative;
+  flex: 1 1 auto;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+  isolation: isolate;
+  color: var(--canvas-text);
+  -webkit-tap-highlight-color: transparent;
+  background: var(--canvas-bg);
+}
+
+/* Shared chat controls bring inline effects and utility classes. Keep the
+   entire canvas flat without changing their appearance elsewhere in the app. */
+.canvas-app *,
+.canvas-app *::before,
+.canvas-app *::after {
+  backdrop-filter: none !important;
+  -webkit-backdrop-filter: none !important;
+  filter: none !important;
+  box-shadow: none !important;
+  text-shadow: none !important;
+  transition: none !important;
+}
+
+.canvas-app :focus-visible {
+  outline: 2px solid var(--canvas-blue) !important;
+  outline-offset: -2px;
+}
+
+/* These editors already have a focus outline on their surrounding control. */
+.canvas-app .canvas-search-box input:focus-visible,
+.canvas-app .block-chat [data-component="prompt-input"]:focus-visible {
+  outline: none !important;
+}
+
+/* The shared counter normalizes its digit strip on transitionend. */
+.canvas-app [data-slot="animated-number-strip"][data-animating="true"] {
+  transition: transform 1ms linear !important;
+}
+
+.canvas-app [data-slot="text-shimmer-char-shimmer"],
+.canvas-app [data-slot="text-shimmer-v2-shimmer"] {
+  display: none !important;
+  animation: none !important;
+  will-change: auto !important;
+}
+
+.canvas-app [data-slot="text-shimmer-char-base"],
+.canvas-app [data-slot="text-shimmer-v2-base"] {
+  opacity: 1 !important;
+}
+
+.canvas-viewport {
+  position: absolute;
+  inset: 71px 0 0 0;
+  overflow: hidden;
+  cursor: grab;
+  touch-action: none;
+}
+
+.canvas-viewport.is-panning {
+  cursor: grabbing;
+}
+
+.canvas-grid {
+  position: absolute;
+  inset: -48px;
+  pointer-events: none;
+  background-image: radial-gradient(circle, var(--canvas-grid-dot) 1.1px, transparent 1.2px);
+  background-position: 48px 48px;
+  background-size: 24px 24px;
+  transform-origin: 0 0;
+  will-change: transform;
+}
+
+.canvas-world {
+  position: absolute;
+  inset: 0;
+  transform-origin: 0 0;
+  will-change: transform;
+}
+
+.canvas-world-scale {
+  position: absolute;
+  inset: 0;
+  transform-origin: 0 0;
+}
+
+/* Blocks */
+
+.canvas-card {
+  --accent: var(--canvas-blue);
+  --canvas-accent-ink: color-mix(in srgb, var(--accent) 35%, var(--canvas-text));
+  position: absolute;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border: 1px solid var(--canvas-line);
+  border-radius: 24px;
+  background: var(--canvas-surface);
+  user-select: none;
+  -webkit-user-select: none;
+  -webkit-touch-callout: none;
+}
+
+.canvas-card:hover {
+  border-color: var(--canvas-line-strong);
+}
+
+.canvas-card.selected {
+  border-color: color-mix(in srgb, var(--accent) 52%, var(--canvas-line));
+  outline: 2px solid var(--accent);
+  outline-offset: -2px;
+}
+
+.canvas-card.dragging,
+.canvas-card.resizing {
+  will-change: left, top;
+}
+
+.canvas-card.collapsed {
+  height: 62px !important;
+  min-height: 62px;
+}
+
+.canvas-card.collapsed .canvas-card-body,
+.canvas-card.collapsed .canvas-resize-handle {
+  display: none;
+}
+
+.canvas-card-header {
+  min-height: 62px;
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  padding: 10px 12px 10px 16px;
+  border-bottom: 1px solid var(--canvas-line);
+  background: linear-gradient(115deg, color-mix(in srgb, var(--accent) 6%, transparent), transparent 70%);
+  touch-action: none;
+}
+
+.canvas-editing .canvas-card-header {
+  cursor: grab;
+}
+
+.canvas-card.dragging .canvas-card-header {
+  cursor: grabbing;
+}
+
+.canvas-card.collapsed .canvas-card-header {
+  border-bottom: 0;
+}
+
+.canvas-card-icon {
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  flex: 0 0 auto;
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--accent) 17%, transparent);
+  color: color-mix(in srgb, var(--accent) 92%, var(--canvas-text));
+}
+
+.canvas-card-icon svg,
+.canvas-toolbar svg,
+.canvas-block-bar svg,
+.canvas-block-palette svg,
+.canvas-icon-button svg,
+.canvas-control-button svg {
+  width: 18px;
+  height: 18px;
+  display: block;
+  stroke: currentColor;
+  stroke-width: 1.9;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  fill: none;
+}
+
+.canvas-card-title-wrap {
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.canvas-card-title {
+  margin: 0;
+  overflow: hidden;
+  color: var(--canvas-text);
+  font-size: 14px;
+  font-weight: 750;
+  letter-spacing: -0.01em;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.canvas-card-subtitle {
+  margin-top: 2px;
+  overflow: hidden;
+  color: var(--canvas-muted);
+  font-size: 11px;
+  font-weight: 600;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.canvas-header-actions {
+  display: flex;
+  flex-shrink: 0;
+  gap: 4px;
+  opacity: 0.62;
+}
+
+.canvas-card:hover .canvas-header-actions,
+.canvas-card.selected .canvas-header-actions {
+  opacity: 1;
+}
+
+.canvas-icon-button {
+  width: 30px;
+  height: 30px;
+  display: grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: 10px;
+  color: var(--canvas-muted);
+  background: transparent;
+  cursor: pointer;
+}
+
+.canvas-icon-button:hover {
+  color: var(--canvas-text);
+  background: var(--canvas-surface-hover);
+}
+
+.canvas-icon-button:focus-visible,
+.canvas-control-button:focus-visible,
+.canvas-block-bar-button:focus-visible,
+.canvas-palette-item:focus-visible,
+.canvas-toolbar-button:focus-visible {
+  outline: 3px solid color-mix(in srgb, var(--canvas-blue) 28%, transparent);
+  outline-offset: 2px;
+}
+
+.canvas-card-body {
+  container: canvas-body / size;
+  position: relative;
+  flex: 1 1 auto;
+  min-height: 0;
+  min-width: 0;
+  overflow: auto;
+  color: var(--canvas-text);
+  background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 2%, transparent), transparent 160px);
+  font-size: 12px;
+  line-height: 1.5;
+  user-select: text;
+  -webkit-user-select: text;
+}
+
+/* Small cards scroll the full block body instead of clipping its controls. */
+@container canvas-body (height < 280px) {
+  .canvas-card .canvas-card-body > * {
+    min-height: 280px;
+  }
+}
+
+.canvas-card :where(button, input, textarea, select):focus-visible {
+  outline: 2px solid color-mix(in srgb, var(--accent) 65%, var(--canvas-text));
+  outline-offset: 2px;
+}
+
+.canvas-card-body * {
+  scrollbar-width: thin;
+  scrollbar-color: var(--canvas-line-strong) transparent;
+}
+
+.canvas-resize-handle {
+  position: absolute;
+  right: 5px;
+  bottom: 5px;
+  width: 20px;
+  height: 20px;
+  cursor: nwse-resize;
+  opacity: 0.4;
+  touch-action: none;
+}
+
+.canvas-resize-handle::before,
+.canvas-resize-handle::after {
+  content: "";
+  position: absolute;
+  right: 4px;
+  bottom: 4px;
+  width: 7px;
+  height: 7px;
+  border-right: 1.5px solid var(--canvas-muted);
+  border-bottom: 1.5px solid var(--canvas-muted);
+  border-radius: 0 0 2px 0;
+}
+
+.canvas-resize-handle::after {
+  right: 9px;
+  bottom: 9px;
+  width: 3px;
+  height: 3px;
+}
+
+/* Floating chrome */
+
+.canvas-toolbar {
+  position: absolute;
+  z-index: 10000;
+  top: 14px;
+  left: 50%;
+  height: 56px;
+  max-width: calc(100vw - 28px);
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 7px;
+  border: 1px solid var(--canvas-line);
+  border-radius: 20px;
+  background: var(--canvas-surface);
+  transform: translateX(-50%);
+  overflow: visible;
+}
+
+.canvas-toolbar-group::-webkit-scrollbar {
+  display: none;
+}
+
+.canvas-workspace-menu {
+  position: relative;
+  flex: 0 0 auto;
+}
+
+.canvas-workspace-menu summary::-webkit-details-marker {
+  display: none;
+}
+
+.canvas-workspace-trigger {
+  width: 168px;
+  height: 40px;
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  padding: 0 10px;
+  border-radius: 13px;
+  color: var(--canvas-text);
+  cursor: pointer;
+  list-style: none;
+}
+
+.canvas-workspace-trigger:hover,
+.canvas-workspace-menu[open] .canvas-workspace-trigger {
