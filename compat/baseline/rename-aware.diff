+  icon: "message-square",
+  kind: "builtin",
+
+  renderer: {
+    moduleId: "packages/app/src/functionalities/chat",
+    exportName: "ChatBlock",
+  },
+
+  constraints: {
+    initialAspect: "square",
+    minW: 4,
+    minH: 4,
+    maxW: null,
+    maxH: null,
+  },
+
+  lifecycle: {
+    clientWhenHidden: "suspend",
