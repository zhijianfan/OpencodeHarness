+    maximumQueued: 100,
+  },
+
+  rights: {
+    mount: ["read"],
+    operations: {
+      "chat.read": ["read"],
+      "chat.send.steer": ["write", "execute"],
+      "chat.send.queue": ["write", "execute"],
