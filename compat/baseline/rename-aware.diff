+    await mkdir(inbox, { recursive: true })
+    await writeFile(join(inbox, "chat-1.md"), "# Turn 1\nhello")
+    await writeFile(join(inbox, "chat-2.md"), "world")
+    await writeFile(join(inbox, "notes.txt"), "text")
