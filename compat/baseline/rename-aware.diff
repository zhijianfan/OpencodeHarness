+  border: 1px solid color-mix(in srgb, var(--accent, var(--canvas-purple)) 38%, transparent);
+  border-radius: 12px;
+  color: color-mix(in srgb, var(--accent, var(--canvas-purple)) 35%, var(--canvas-text));
+  background: color-mix(in srgb, var(--accent, var(--canvas-purple)) 18%, var(--canvas-surface-solid));
+  font-size: 11px;
+  font-weight: 780;
+  cursor: pointer;
+}
+
+@media (pointer: coarse) {
+  .master-agent-button,
+  .master-agent-retry-button {
+    min-height: 36px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .master-agent-status.is-loading .master-agent-status-icon {
+    animation: none;
+  }
+}
