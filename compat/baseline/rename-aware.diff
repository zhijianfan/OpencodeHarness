+          new URL(response.url()).pathname === `/api/workspace/${workspaceID}/ctxpack/${pack.id}`,
+      )
+      await chips.locator('[data-action="ctxpack-attachment-preview"]').click()
+      expect((await previewed).status()).toBe(200)
